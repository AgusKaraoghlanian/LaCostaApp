{
  "name": "costa-a-la-carta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-ocr.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ocr.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "dev:api": "node scripts/wrangler-local.mjs dev",
    "db:migrate": "node scripts/wrangler-local.mjs migrate",
    "motor": "node worker/main.ts",
    "build:demo": "node scripts/prepare-ocr.mjs && vite build --mode demo --outDir dist-demo && vite build --mode demo --ssr src/entrada-servidor.jsx --outDir .prerender && node scripts/prerender-demo.mjs",
    "ocr:prepare": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "@tesseract.js-data/spa": "1.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "1.64.1",
    "drizzle-kit": "0.31.11",
    "linkedom": "0.18.14",
    "miniflare": "5.20261006.1-alpha",
    "vite": "7.1.7",
    "wrangler": "4.149.0",
    "esbuild": "0.25.12"
  }
}
