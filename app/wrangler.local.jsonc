{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "costa-a-la-carta-local",
  "main": "server/api/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "dev": {"ip": "127.0.0.1", "port": 8787, "local_protocol": "http"},
  "vars": {"APP_ENV": "local", "AUTH_MODE": "local", "CATALOG_BACKEND": "d1", "UI_ORIGIN": "http://127.0.0.1:5174"},
  "d1_databases": [{"binding": "DB", "database_name": "costa-local-real", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "db/migrations", "remote": false}],
  "kv_namespaces": [{"binding": "MEDIA", "id": "00000000000000000000000000000001", "remote": false}]
}
