# Base de datos (Supabase). DATABASE_URL va por el pooler; DIRECT_URL directo (para migrar).
# En local también sirve un Postgres propio: postgresql://postgres:postgres@localhost:5432/costa
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3001
JWT_SECRET=<un-string-largo-y-aleatorio>

# Administrador inicial: lo crea "npm run seed" (solo hace falta la primera vez)
ADMIN_EMAIL=<email-del-admin>
ADMIN_PASSWORD=<minimo-8-caracteres>
ADMIN_NOMBRE=<nombre-y-apellido>

# Producción: NODE_ENV=production. JWT_SECRET tiene que tener al menos 32 caracteres al azar
# (ej. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
NODE_ENV=development
# Sitios que pueden llamar a la API desde el navegador, separados por comas (en desarrollo,
# si no está, se acepta http://localhost:5173).
CORS_ORIGENES=http://localhost:5173

# Fotos subidas desde el admin. Sin esto (desarrollo) se guardan en backend/uploads.
# En producción: Supabase Storage, con un bucket público (por defecto "fotos").
# La clave secreta (sb_secret_... o la service_role "legacy") es secreta: solo va en el backend, nunca en el frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BUCKET=fotos
